# Copia este fichero a .env.local (gitignored) y ajusta.

# --- Base de datos (Turso / libSQL) ---
# Local: SQLite en fichero, sin cuenta de Turso (npm run db:migrate lo crea).
TURSO_DATABASE_URL=file:.data/dev.db
TURSO_AUTH_TOKEN=
# En Vercel (Project Settings → Environment Variables):
#   TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io   (turso db show <db> --url)
#   TURSO_AUTH_TOKEN=<token>                          (turso db tokens create <db>)

# --- Registro ---
# Si se define, crear cuenta exige este código de invitación; vacío = registro abierto.
REGISTRATION_CODE=
